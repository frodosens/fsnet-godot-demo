# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# Local native dependencies and generated binaries
build/
bin/*
.deps/
*.log
*.zip

# Documentation image imports are not runtime assets
docs/*.import

# Importer-generated metadata. The engine recreates these on every open/import,
# and all of the generated ones use default settings, so versioning them only
# adds churn when the engine version changes the import format.
# The .import files that ARE tracked carry non-default settings (mipmaps on
# environment textures, loop flags on audio); keep them tracked and add a new
# customised one explicitly with `git add -f`.
*.import
*.uid

# Local test reports and captured logs (tools/test-headless.ps1)
artifacts/

# Versioned Windows runtime; other native outputs remain local.
!bin/windows/
!bin/windows/**
/build-windows-cross/
