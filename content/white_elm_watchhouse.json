    "events": [
      {
        "id": "watchhouse_arrival",
        "trigger": "chapter_enter_before_first_player_action",
        "lines": [
          {
            "speaker": "narrator",
            "text": "翌日，药箱已在白榆镇药房安放妥当。玛拉一行带着未拆的值房来信，沿旧路去核对桥卫的欠薪与收款记录。"
          },
          {
            "speaker": "adela",
            "text": "先停下。奥伦昨日才在桥头私收过钱，如今谁能证明你们不是来替他拿走账册？"
          },
          {
            "speaker": "mara",
            "text": "账册留在原处，由在场的人一起核对。我们只送这封仍封着口的信。"
          },
          {
            "speaker": "elsbet",
            "text": "门前有人接收信件。可在核明身份之前，我不能放任你们穿过封存的车货。"
          },
          {
            "speaker": "finn",
            "text": "那就走空着的路。信封、货物和各位的脑袋，都别弄坏了。"
          },
          {
            "speaker": "neri",
            "text": "守住玛拉，让她把信交到门前。挡开就够了，不追击倒下的人。"
          }
        ]
      },
      {
        "id": "watchhouse_reminder",
        "trigger": "first_player_turn_started_with_round_gte_2",
        "lines": [
          {
            "speaker": "adela",
            "text": "箱子上的封条别碰！"
          },
          {
            "speaker": "mara",
            "text": "我们不碰。请让门前的人看清信封，也听听双方的话。"
          }
        ]
      },
      {
        "id": "watchhouse_victory",
        "trigger": "battle_terminal_victory",
        "lines": [
          {
            "speaker": "narrator",
            "text": "玛拉在值房门前停住，将封好的信交到接收人手里。接收人当着双方的面核验了来处，示意庭院里的人停止争斗。"
          },
          {
            "speaker": "mara",
            "text": "先照看失去战力的人。核账就在这里进行，谁也不私自搬走东西。"
          },
          {
            "speaker": "narrator",
            "text": "信中请求留存旧桥卫的值守与修缮记录，供白榆镇核对。它并不是免除奥伦责任的凭据。"
          },
          {
            "speaker": "narrator",
            "text": "欠薪、修缮款与昨日应退的钱，分别记录、分别核查。受伤者也得到照料，争执并不因此被掩去。"
          },
          {
            "speaker": "narrator",
            "text": "一张桌子被搬到门边。账还没有结清，但这一次，人们终于坐在一起逐项说话。"
          }
        ]
      },
      {
        "id": "watchhouse_defeat",
        "trigger": "battle_terminal_defeat",
        "lines": [
          {
            "speaker": "narrator",
            "text": "玛拉失去战力，护送队停止前进。来信仍封着口，账册也未被取走。"
          },
          {
            "speaker": "narrator",
            "text": "双方先为伤者让出位置。待队伍恢复，再重新尝试递交信件。"
          }
        ]
      }
    ],
    "schemaVersion": 1
  },
