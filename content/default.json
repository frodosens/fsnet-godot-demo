  "story": {
    "schemaVersion": 1,
    "storyId": "amber_bridge_letters",
    "title": "琥珀桥来信",
    "chapterId": "ch01",
    "chapterTitle": "第一章 · 桥上的欠条",
    "logline": "三名短期受雇的护送者，把一箱药与一袋家书送往桥那头，却在黄昏前遇上了三个不肯放下欠条，也不肯让路的人。",
    "background": "暮秋的柳河谷没有等待被拯救的王国，只有赶在雨季前收完的麦子、漏水的屋顶和迟迟没到的信。琥珀桥连接河湾集市与白榆镇，商路迁走后，旧桥卫队被解散，结清工钱的承诺却留在账本上。近来，桥上出现了未经许可的过路费。玛拉、芬恩与奈莉受镇上药房之托，护送药箱和顺路捎带的家书。这份委托本该在晚饭前结束。",
    "tone": "温暖克制的欧式低魔幻想；小人物的生计、信誉与责任。争执可理解，拦路伤人不可开脱。战斗中的倒下统一表示失去战斗能力；剧情不新增杀戮、审判或世界危机。",
    "characters": [
      {
        "id": "mara",
        "name": "玛拉",
        "legacyName": "Mara",
        "role": "骑士",
        "side": "ally",
        "motivation": "把人和货完整送到，不拿别人的急难讨价还价。",
        "relationship": "队伍领头者；信任奈莉的判断，也让芬恩学会先辨清人、再松弓弦。",
        "portrait": "32岁女剑士；栗棕下颌短发、浅褐眼、微晒肤色；红围巾、磨旧银甲、棕皮肩带；沉稳坚定。"
      },
      {
        "id": "finn",
        "name": "芬恩",
        "legacyName": "Finn",
        "role": "弓手",
        "side": "ally",
        "motivation": "证明第一次正式护送不是靠运气；曾帮家人摆摊，熟悉每一枚零钱的分量。",
        "relationship": "以玩笑缓和玛拉的严肃；向奈莉请教如何不伤人也能制止危险。",
        "portrait": "21岁男弓手；蜂蜜棕蓬松短发、鼻梁雀斑、绿眼；苔绿兜帽披风、皮箭袋肩带；机灵认真。"
      },
      {
        "id": "neri",
        "name": "奈莉",
        "legacyName": "Neri",
        "role": "法师",
        "side": "ally",
        "motivation": "把会受潮的药材送进干燥的药柜；魔法是修灯、烘药与挡开刀锋的手艺。",
        "relationship": "队内耐心的调停者，但不会用同情替别人免除责任。",
        "portrait": "29岁女法师；深棕肤色、深靛卷发小髻、琥珀眼；蓝斗篷、黄铜圆扣、米白内领；温和务实。"
      },
      {
        "id": "oren",
        "name": "奥伦",
        "legacyName": "Raider",
        "role": "前桥卫队长",
        "side": "enemy",
        "motivation": "被欠两个月工钱，以私设关卡逼商路管事出面；清楚越界却把退让误当认输。",
        "relationship": "带着苔莎与布兰守过桥，对他们有责任，却作出了错误决定。",
        "portrait": "46岁男性；短灰黑发、盐胡椒短须、眼下疲态；褪赭皮肩甲、旧黄铜桥形徽章；疲惫执拗。"
      },
      {
        "id": "tessa",
        "name": "苔莎",
        "legacyName": "Scout",
        "role": "前桥卫斥候",
        "side": "enemy",
        "motivation": "想替旧同伴讨回工钱；原以为只会拦空车，看见药箱后开始怀疑。",
        "relationship": "信任奥伦旧日的担当，但这一回愿意当面指出他的错误。",
        "portrait": "25岁女性；黑短发、单侧细编辫、灰绿眼；灰绿兜帽披肩、细小铜耳环；警惕犹疑。"
      },
      {
        "id": "bram",
        "name": "布兰",
        "legacyName": "Brute",
        "role": "桥工",
        "side": "enemy",
        "motivation": "修过这座桥，也被拖欠修缮工钱；听从奥伦，却不愿真的伤到赶路人。",
        "relationship": "力气最大，争吵时声音最小；最后愿意亲手搬走自己设下的路障。",
        "portrait": "39岁壮实男性；宽厚圆脸、赤褐络腮胡、短卷发；米黄补丁粗布领、厚棕皮围肩；愧疚微蹙眉。"
      }
    ],
    "events": [
      {
        "id": "ch01_intro",
        "trigger": "chapter_enter_before_first_player_action",
        "once": true,
        "lines": [
          {
            "speaker": "narrator",
            "text": "暮秋，琥珀桥。再走半刻钟，药箱和家书就能送到白榆镇。"
          },
          {
            "speaker": "finn",
            "text": "药箱没淋湿，信袋也没丢。要是桥那头还有热汤，这趟就算十全十美。"
          },
          {
            "speaker": "neri",
            "text": "先送药。汤凉了还能热，受潮的药可不行。"
          },
          {
            "speaker": "oren",
            "text": "停步。过桥费，连人带货，十二枚银币。"
          },
          {
            "speaker": "mara",
            "text": "桥头没有征费告示。你收的是什么钱？"
          },
          {
            "speaker": "oren",
            "text": "我们守桥两个月的工钱。商路换了，账却没人认。今天起，谁过桥谁补上。"
          },
          {
            "speaker": "neri",
            "text": "箱里是镇上等着用的药。欠钱的不是他们。"
          },
          {
            "speaker": "tessa",
            "text": "奥伦……他们的封条是药房的。"
          },
          {
            "speaker": "oren",
            "text": "不付钱，就把货留下。我不会再被一句“明天再说”打发走。"
          },
          {
            "speaker": "mara",
            "text": "工钱该讨，但不能从病人手里抢。让路。"
          },
          {
            "speaker": "bram",
            "text": "……队长，真要动手？"
          },
          {
            "speaker": "oren",
            "text": "拦住他们。"
          },
          {
            "speaker": "mara",
            "text": "挡开他们，守住药箱。别追击失去战力的人。"
          }
        ]
      },
      {
        "id": "ch01_mid_debt",
        "trigger": "first_player_turn_started_with_round_gte_2",
        "once": true,
        "lines": [
          {
            "speaker": "finn",
            "text": "那枚桥形徽章……你们真是旧桥卫？"
          },
          {
            "speaker": "oren",
            "text": "去年涨水，是我们整夜守着这里。现在连修靴子的钱都拿不出来。"
          },
          {
            "speaker": "mara",
            "text": "那就带着欠条去找欠钱的人。你今天拦下的，没有一个欠你钱。"
          },
          {
            "speaker": "tessa",
            "text": "她说得没错，奥伦。我们一开始说好，不碰送药的。"
          }
        ]
      },
      {
        "id": "ch01_mid_doubt",
        "trigger": "first_player_turn_started_with_round_gte_3",
        "once": true,
        "lines": [
          {
            "speaker": "bram",
            "text": "桥是我补的……我本来是想让大家好走一点。"
          },
          {
            "speaker": "neri",
            "text": "那就别把它变成大家害怕的地方。现在停手，还能把路让出来。"
          },
          {
            "speaker": "oren",
            "text": "……布兰，往后站。别再伤到自己。"
          },
          {
            "speaker": "mara",
            "text": "听清楚：路要通，拦路的事也要有人负责。两件事都不会被一张欠条抹掉。"
          }
        ]
      },
      {
        "id": "ch01_victory",
        "trigger": "battle_terminal_victory",
        "once": true,
        "lines": [
          {
            "speaker": "narrator",
            "text": "刀锋放低了。奈莉替伤者包扎，布兰坐着缓了口气。药箱的封条仍然完好。"
          },
          {
            "speaker": "oren",
            "text": "……是我下的令。我跟你们去镇上，把拦路收钱的事说清楚。"
          },
          {
            "speaker": "mara",
            "text": "收过的钱，要照实记下来归还。工钱的欠条也带上——它该被受理，但不是拿来抵这笔账。"
          },
          {
            "speaker": "tessa",
            "text": "我记得收了哪几辆车的钱。我来写，漏了的再去问。"
          },
          {
            "speaker": "bram",
            "text": "等我站稳，我把路障搬走。是我摆的。"
          },
          {
            "speaker": "neri",
            "text": "先把绷带系好。我们会为欠条作证，不会替拦路伤人的事遮掩。"
          },
          {
            "speaker": "finn",
            "text": "信袋里还有一封给桥卫值房的信。地址没改，要等你们回去再拆了。"
          },
          {
            "speaker": "oren",
            "text": "……替我留着。至少这回，我不会再把该面对的事推到明天。"
          },
          {
            "speaker": "narrator",
            "text": "黄昏时，药箱送进了白榆镇的药房。欠薪还要核账，赔还也有待逐笔办妥；但琥珀桥上，终于又能好好走路了。"
          },
          {
            "speaker": "finn",
            "text": "现在能喝汤了吗？"
          },
          {
            "speaker": "mara",
            "text": "能。你的那碗，别又把面包全泡进去。"
          }
        ]
      },
      {
        "id": "ch01_defeat",
        "trigger": "battle_terminal_defeat",
        "once": true,
        "lines": [
          {
            "speaker": "narrator",
            "text": "三人退回了河岸的旧磨坊。药箱和信袋抢回来了，但今天没能从桥上过去。"
          },
          {
            "speaker": "neri",
            "text": "都还在。药也没湿。先处理伤口，别急着再冲一次。"
          },
          {
            "speaker": "finn",
            "text": "我记住了他们的站位。下回先找好掩护。"
          },
          {
            "speaker": "mara",
            "text": "委托还没完。歇一口气，我们重新想办法。"
          },
          {
            "speaker": "narrator",
            "text": "这不是他们想要的一页。重试将从桥头重新开始。"
          }
        ]
      }
    ],
