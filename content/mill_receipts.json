    "events": [
      {
        "id": "mill_arrival",
        "trigger": "chapter_enter_before_first_player_action",
        "lines": [
          {
            "speaker": "narrator",
            "text": "值房的核账还在继续。一笔修缮材料已有支出记录，却缺货栈经手人的签收副本。玛拉三人来到水闸旁，请对方当面核验。"
          },
          {
            "speaker": "rodd",
            "text": "货物和账册都封存着。没有通知，谁也不能搬走。"
          },
          {
            "speaker": "mara",
            "text": "原件留在这里。我们请经手人核对，只带走经双方确认的副本。"
          },
          {
            "speaker": "vera",
            "text": "桥头刚出过私收钱的事，我们不能只凭一句话放人过去。"
          },
          {
            "speaker": "neri",
            "text": "走空着的通路，别碰货堆。先让办事棚的人听清来意。"
          },
          {
            "speaker": "finn",
            "text": "还是老规矩：挡开就够了，不追击倒下的人。"
          }
        ]
      },
      {
        "id": "mill_reminder",
        "trigger": "first_player_turn_started_with_round_gte_2",
        "lines": [
          {
            "speaker": "rodd",
            "text": "封条不能碰！"
          },
          {
            "speaker": "mara",
            "text": "我们不碰。请让经手人来办公室前的接洽空地，当着大家的面核验。"
          }
        ]
      },
      {
        "id": "mill_victory",
        "trigger": "battle_terminal_victory",
        "lines": [
          {
            "speaker": "narrator",
            "text": "玛拉在办公室前的接洽空地停下。经手人听清来意，示意守场人收起武器，先照看失去战力的人。"
          },
          {
            "speaker": "mara",
            "text": "原账不离开货栈。日期、数量和签收人，请双方一起核对。"
          },
          {
            "speaker": "narrator",
            "text": "一份材料交接记录得到确认。它只说明这批材料的去向，不抵消欠薪，也不免除应退的钱。"
          },
          {
            "speaker": "neri",
            "text": "副本带回值房。剩下的账，仍要一笔一笔核清。"
          }
        ]
      },
      {
        "id": "mill_defeat",
        "trigger": "battle_terminal_defeat",
        "lines": [
          {
            "speaker": "narrator",
            "text": "玛拉失去战力，队伍停止前进。封存的货物与账册都留在原处。"
          },
          {
            "speaker": "neri",
            "text": "先处理伤口。核验的事还没完成，我们另想办法。"
          }
        ]
      }
    ]
  },
