    "events": [
      {
        "id": "ch03_before_sluice",
        "trigger": "chapter_enter_before_first_player_action",
        "lines": [
          {
            "speaker": "neri",
            "text": "请问，去医师家的路是这边吗？"
          },
          {
            "speaker": "finn",
            "text": "原来是。桥头刚设了岗。"
          },
          {
            "speaker": "mara",
            "text": "还有别的路？"
          },
          {
            "speaker": "finn",
            "text": "有，不过得绕。你们找他干什么？"
          },
          {
            "speaker": "neri",
            "text": "问几个伤员的下落。值房送来的。"
          },
          {
            "speaker": "finn",
            "text": "那你们得快点。我刚看见他们把医师也叫过去了。"
          },
          {
            "speaker": "mara",
            "text": "你能带路吗？"
          },
          {
            "speaker": "finn",
            "text": "能。我叫芬恩。"
          },
          {
            "speaker": "neri",
            "text": "奈莉。这是玛拉。"
          },
          {
            "speaker": "finn",
            "text": "有人过来了。别走正桥，从下面绕。"
          },
          {
            "speaker": "mara",
            "text": "你走过？"
          },
          {
            "speaker": "finn",
            "text": "昨天还走过。跟我来。"
          }
        ]
      },
      {
        "id": "ch03_after_sluice",
        "trigger": "battle_terminal_victory",
        "lines": [
          {
            "speaker": "neri",
            "text": "人呢？那三个伤员。"
          },
          {
            "speaker": "physician",
            "text": "送去旧采石场了。天亮以后处置。"
          },
          {
            "speaker": "neri",
            "text": "明天？"
          },
          {
            "speaker": "physician",
            "text": "嗯。我想再给他们换次药，没让进去。"
          },
          {
            "speaker": "mara",
            "text": "采石场有几条路？"
          },
          {
            "speaker": "finn",
            "text": "两条。拉石头的大路，还有山坡那条小路。"
          },
          {
            "speaker": "mara",
            "text": "你已经把我们带到了。接下来不用跟着。"
          },
          {
            "speaker": "finn",
            "text": "他们刚才也看见我了。我现在回去，照样要被问。"
          },
          {
            "speaker": "neri",
            "text": "你家里呢？"
          },
          {
            "speaker": "finn",
            "text": "我托人带句话。先把这事弄完。"
          },
          {
            "speaker": "mara",
            "text": "那就一起。入夜前回来，我们得商量一下。"
          }
        ]
      },
      {
        "id": "ch03_defeat",
        "trigger": "battle_terminal_defeat",
        "lines": [
          {
            "speaker": "mara",
            "text": "先退回去。我们换条路。"
          }
        ]
      },
