    "events": [
      {
        "id": "ch01_before_bridge",
        "trigger": "chapter_enter_before_first_player_action",
        "lines": [
          {
            "speaker": "neri",
            "text": "过了桥，再往北走就是值房。"
          },
          {
            "speaker": "mara",
            "text": "你说的是去程吧？"
          },
          {
            "speaker": "neri",
            "text": "嗯。回来还要接几个人。有人走不快。"
          },
          {
            "speaker": "mara",
            "text": "这个你出门前没说。"
          },
          {
            "speaker": "neri",
            "text": "……现在说，还来得及吗？"
          },
          {
            "speaker": "mara",
            "text": "先看看路。"
          },
          {
            "speaker": "road_guard",
            "text": "停下。今天不让过。"
          },
          {
            "speaker": "mara",
            "text": "谁的命令？"
          },
          {
            "speaker": "road_guard",
            "text": "我的。把包留下，人可以走。"
          },
          {
            "speaker": "neri",
            "text": "里面是药。"
          },
          {
            "speaker": "road_guard",
            "text": "那正好。"
          },
          {
            "speaker": "mara",
            "text": "退后一点。"
          },
          {
            "speaker": "neri",
            "text": "我在这里就行。你别挡着我。"
          }
        ]
      },
      {
        "id": "ch01_after_bridge",
        "trigger": "battle_terminal_victory",
        "lines": [
          {
            "speaker": "mara",
            "text": "手怎么了？"
          },
          {
            "speaker": "neri",
            "text": "蹭了一下。没事。"
          },
          {
            "speaker": "mara",
            "text": "你先给自己包上。"
          },
          {
            "speaker": "neri",
            "text": "刚才谢了。"
          },
          {
            "speaker": "mara",
            "text": "回程有几个人？"
          },
          {
            "speaker": "neri",
            "text": "原来说六个。值房会把能走的先送出来。"
          },
          {
            "speaker": "mara",
            "text": "那得找辆车。"
          },
          {
            "speaker": "neri",
            "text": "我想到了。不过……还没借到。"
          },
          {
            "speaker": "mara",
            "text": "到了再问。先赶路。"
          }
        ]
      },
      {
        "id": "ch01_defeat",
        "trigger": "battle_terminal_defeat",
        "lines": [
          {
            "speaker": "mara",
            "text": "先退回去。我们换条路。"
          }
        ]
      },
      {
        "id": "homeward_01_finish",
        "trigger": "campaign_finish",
        "lines": []
      }
    ]
  },
