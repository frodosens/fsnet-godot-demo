    "events": [
      {
        "id": "ch02_before_watchhouse",
        "trigger": "chapter_enter_before_first_player_action",
        "lines": [
          {
            "speaker": "neri",
            "text": "奥伦？你能站起来吗？"
          },
          {
            "speaker": "oren",
            "text": "能。坐久了，腿有点麻。"
          },
          {
            "speaker": "neri",
            "text": "先别急。其他人呢？"
          },
          {
            "speaker": "oren",
            "text": "车边两个。"
          },
          {
            "speaker": "neri",
            "text": "还有三个。昨天不是说一起走？"
          },
          {
            "speaker": "watch_guard",
            "text": "那三个不走。转走了。"
          },
          {
            "speaker": "neri",
            "text": "转去哪儿？有一个伤口还在发热。"
          },
          {
            "speaker": "watch_guard",
            "text": "我不知道。上头改的。"
          },
          {
            "speaker": "mara",
            "text": "我们只接人。已经放出来的，现在能带走吧？"
          },
          {
            "speaker": "watch_guard",
            "text": "……先别走。带队的要问话。"
          },
          {
            "speaker": "oren",
            "text": "他刚才还说我能走。"
          },
          {
            "speaker": "watch_guard",
            "text": "把他们拦住。"
          },
          {
            "speaker": "mara",
            "text": "奈莉，往外走。别往门里去。"
          }
        ]
      },
      {
        "id": "ch02_after_watchhouse",
        "trigger": "battle_terminal_victory",
        "lines": [
          {
            "speaker": "mara",
            "text": "另外两个人住下了。掌柜要我们明早就走。"
          },
          {
            "speaker": "neri",
            "text": "我再出去一趟。"
          },
          {
            "speaker": "mara",
            "text": "去哪儿？"
          },
          {
            "speaker": "neri",
            "text": "水闸。之前照看他们的医师住那边。他可能知道人被送去哪了。"
          },
          {
            "speaker": "mara",
            "text": "你打算自己去？"
          },
          {
            "speaker": "neri",
            "text": "你的委托到这里就算完了。"
          },
          {
            "speaker": "mara",
            "text": "我问的不是这个。你认识路吗？"
          },
          {
            "speaker": "neri",
            "text": "……大概认识。"
          },
          {
            "speaker": "mara",
            "text": "先吃点东西。找个认路的，再走。"
          },
          {
            "speaker": "oren",
            "text": "那三个人……以前跟着我。"
          },
          {
            "speaker": "neri",
            "text": "你知道为什么不放他们？"
          },
          {
            "speaker": "oren",
            "text": "我得想想，怎么说。"
          },
          {
            "speaker": "mara",
            "text": "别想太久。"
          }
        ]
      },
      {
        "id": "ch02_defeat",
        "trigger": "battle_terminal_defeat",
        "lines": [
          {
            "speaker": "mara",
            "text": "先退回去。我们换条路。"
          }
        ]
      },
      {
        "id": "homeward_02_finish",
        "trigger": "campaign_finish",
        "lines": []
      }
    ]
  },
